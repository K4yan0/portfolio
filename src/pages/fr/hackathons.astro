---
import BaseLayout from '../../components/BaseLayout.astro';
---

<BaseLayout title="Hackathons | System." description="Hackathons et compétitions.">
  <div class="space-y-16">
    <header class="border-b border-cohere-hairline pb-12 max-w-4xl">
      <h1 class="font-display text-[48px] md:text-[64px] tracking-tight text-cohere-nearblack mb-4">Hackathons</h1>
      <p class="font-body text-[20px] text-cohere-muted">Compétitions, sessions intensives de développement et sprints d'innovation.</p>
    </header>

    <div class="py-12 flex flex-col items-center justify-center text-center space-y-6 bg-white border border-cohere-hairline rounded-lg">
      <div class="text-[48px] opacity-50">🏆</div>
      <h2 class="font-display text-[24px] tracking-tight text-cohere-nearblack">Pas encore de hackathons</h2>
      <p class="font-body text-[16px] text-cohere-ink opacity-80 max-w-md mx-auto">
        Je suis activement à la recherche d'opportunités pour participer à des hackathons. Revenez plus tard pour voir mes futurs projets de compétition !
      </p>
    </div>
  </div>
</BaseLayout>
