---
import BaseLayout from '../components/BaseLayout.astro';
import { Tag } from '../components/Tag';

const techStack = [
  "Python", "C++", "PowerBI", "Machine Learning", "Data Engineering", 
  "Embedded Systems", "Docker", "Kubernetes", "Terraform", "GCP", "English (TOEIC 950)"
];
---

<BaseLayout title="About | Developer Portfolio" description="About the engineer behind the systems.">
  <div class="max-w-3xl mx-auto space-y-24">
    
    <!-- Hero Text -->
    <section class="space-y-8 border-b border-cohere-hairline pb-16">
      <h1 class="font-display text-[60px] md:text-[80px] leading-[0.95] tracking-[-1.92px] text-cohere-nearblack">
        Driven by <br/> complexity.
      </h1>
      <p class="font-body text-[20px] md:text-[24px] leading-[1.5] text-cohere-ink opacity-90 max-w-2xl">
        I am a dual-degree engineering student at ESIEA and SKEMA Business School. I build bridges between low-level embedded hardware and high-level artificial intelligence.
      </p>
    </section>

    <!-- Manifesto / Deep Dive -->
    <section class="space-y-12">
      <div class="space-y-6">
        <h2 class="font-display text-[32px] tracking-[-0.32px] text-cohere-nearblack">The Journey</h2>
        <div class="font-body text-[18px] leading-[1.6] text-cohere-ink opacity-90 space-y-6">
          <p>
            Coming from a rigorous background in advanced mathematics and physics, I developed a structural approach to problem-solving early on. I later pursued an academic exchange at SeoulTech in South Korea, where I immersed myself in Machine Learning and Quantum Computing.
          </p>
          <p>
            When choosing my engineering specialization, I was torn between AI and Embedded Systems. I ultimately chose Embedded Systems, driven by the conviction that these two fields will become intimately intertwined in the coming years. Edge AI and intelligent hardware are the future.
          </p>
          <p>
            Beyond academics, my professional experiences—ranging from public sector observations in hospitals to technical data engineering at NG Metrics—have shown me the immense need for robust IT solutions across all industries. I am currently completing my double degree (MSc AIBT) and actively looking for my final technical internship for the second semester of 2027 (open to international opportunities).
          </p>
        </div>
      </div>
      
      <div class="space-y-6 pt-8">
        <h2 class="font-display text-[32px] tracking-[-0.32px] text-cohere-nearblack">The Arsenal</h2>
        <p class="font-body text-[16px] leading-[1.6] text-cohere-ink opacity-90">
          My technical stack bridges the gap between hardware execution and data intelligence.
        </p>
        
        <div class="flex flex-wrap gap-3 pt-4">
          {techStack.map(tech => (
            <Tag variant="tech" label={tech} />
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
