---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import { Tag } from '../../components/Tag';
import { Button } from '../../components/Button';

export async function getStaticPaths() {
  const projectsEntries = await getCollection('projects');
  return projectsEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Project`} description={entry.data.description}>
  <article class="max-w-4xl mx-auto py-12 md:py-20">
    <header class="mb-20 space-y-12">
      {entry.data.coverImage && (
        <div class="w-full aspect-video rounded-[22px] overflow-hidden border border-cohere-hairline bg-cohere-stone shadow-sm">
          <img src={entry.data.coverImage} alt={entry.data.title} class="w-full h-full object-cover" />
        </div>
      )}
      
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-12 border-b border-cohere-hairline pb-12">
        <div class="space-y-6 max-w-2xl">
          <h1 class="font-display text-[48px] md:text-[72px] leading-[1.0] tracking-[-1.44px] text-cohere-nearblack">
            {entry.data.title}
          </h1>
          <p class="font-body text-[20px] md:text-[24px] leading-[1.5] text-cohere-muted">
            {entry.data.description}
          </p>
          
          <div class="flex flex-wrap gap-2 pt-4">
            {entry.data.techStack.map((tech) => (
              <Tag variant="tech" label={tech} />
            ))}
          </div>
        </div>
        
        <div class="flex flex-col gap-4 shrink-0 min-w-[200px]">
          <div class="font-mono text-[12px] text-cohere-muted tracking-wider uppercase mb-2">
            Launched {entry.data.launchDate.getFullYear()}
          </div>
          {entry.data.liveUrl && (
            <Button variant="primary" href={entry.data.liveUrl}>Visit Live Site</Button>
          )}
          {entry.data.githubUrl && (
            <Button variant="outline" href={entry.data.githubUrl}>View Source</Button>
          )}
        </div>
      </div>
    </header>

    <div class="max-w-3xl mx-auto prose prose-lg 
      prose-headings:font-display prose-headings:text-cohere-nearblack prose-headings:tracking-tight
      prose-h1:text-[48px] prose-h1:tracking-[-0.48px] prose-h1:leading-[1.2]
      prose-h2:text-[32px] prose-h2:tracking-[-0.32px] prose-h2:leading-[1.2]
      prose-h3:text-[24px] prose-h3:leading-[1.3]
      prose-p:font-body prose-p:text-cohere-ink prose-p:text-[18px] prose-p:leading-[1.6]
      prose-a:text-cohere-blue prose-a:underline prose-a:underline-offset-4 prose-a:decoration-cohere-hairline hover:prose-a:decoration-cohere-blue transition-colors
      prose-code:font-mono prose-code:text-[14px] prose-code:bg-cohere-stone prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-code:border prose-code:border-cohere-hairline before:content-none after:content-none
      prose-pre:border prose-pre:border-cohere-hairline prose-pre:rounded-lg prose-pre:bg-cohere-nearblack
      prose-strong:text-cohere-nearblack prose-strong:font-medium
      prose-hr:border-cohere-hairline
      prose-blockquote:border-l-cohere-hairline prose-blockquote:border-l-[1px] prose-blockquote:text-cohere-slate prose-blockquote:font-normal prose-blockquote:not-italic
      prose-ul:font-body prose-ul:text-cohere-ink prose-ol:font-body prose-ol:text-cohere-ink
      prose-li:my-1
    ">
      <Content />
    </div>
  </article>
</BaseLayout>
