---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import { Button } from '../components/Button';
import { ProjectCard } from '../components/ProjectCard';

const allProjects = await getCollection('projects');
// Featured projects selected by priority: Exoplanet ML (#1) and Enterprise Data Agent (#2)
const prioritySlugs = ['exoplanet-ml', 'enterprise-agent'];
const featuredProjects = prioritySlugs
  .map(slug => allProjects.find(p => p.id.startsWith('en/') && p.id.includes(slug)))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<BaseLayout title="Swan. | Developer Portfolio" description="A minimalist engineering showcase." fullBleed={true}>
  <div>
    
    <!-- Band 1: Hero Section (Canvas White) -->
    <section class="w-full bg-cohere-canvas">
      <div class="max-w-7xl mx-auto px-6 py-16 md:px-12 md:py-24 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-7 space-y-10">
          <h1 class="font-display text-[64px] md:text-[80px] leading-[0.95] tracking-[-1.92px] text-cohere-nearblack">
            AI & Data Engineering, <br class="hidden md:block"/> from edge to enterprise.
          </h1>
          <p class="font-body text-[18px] md:text-[20px] leading-[1.6] text-cohere-ink max-w-xl opacity-90">
            Dual-degree engineering student at ESIEA (Embedded Systems & AI) and SKEMA Business School (MSc AI for Business Transformation). I build production data pipelines, explainable ML architectures, and intelligent agents—bridging low-level telemetry with enterprise-scale data systems.
          </p>
          <div class="flex flex-wrap items-center gap-6 pt-4">
            <Button variant="primary" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/projects`}>Explore Projects</Button>
            <Button variant="secondary" href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/about`}>More About Me</Button>
          </div>

          <!-- Mobile-only Compact Status Card -->
          <div class="md:hidden pt-2">
            <div class="bg-cohere-nearblack text-white rounded-md p-3.5 border border-cohere-hairline/20 flex items-center gap-3.5">
              <img 
                src={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/images/hero.jpg`} 
                alt="Swan - Developer" 
                class="w-11 h-11 rounded-sm object-cover grayscale shrink-0 border border-white/15"
              />
              <div class="min-w-0 flex flex-col gap-0.5">
                <span class="font-mono text-[10px] uppercase tracking-wider text-white/60">System.Status</span>
                <span class="font-mono text-[11px] uppercase tracking-wider text-cohere-softcoral flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-cohere-softcoral animate-pulse shrink-0"></span>
                  <span class="truncate">Available May 2027 • 6-Mo Internship</span>
                </span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="lg:col-span-5 relative group hidden md:block">
          <div class="relative w-full aspect-square md:aspect-[4/5] bg-cohere-stone rounded-[22px] border border-cohere-hairline overflow-hidden">
            <img 
              src={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/images/hero.jpg`} 
              alt="Swan - Developer" 
              class="w-full h-full object-cover grayscale opacity-90 transition-all duration-1000 hover:grayscale-0 hover:opacity-100 hover:scale-105"
            />
            <div class="absolute bottom-4 left-4 right-4 bg-cohere-nearblack/90 backdrop-blur-md border border-cohere-hairline/20 rounded-md p-4 flex items-center justify-between">
              <span class="font-mono text-[11px] uppercase tracking-wider text-white">System.Status</span>
              <span class="font-mono text-[11px] uppercase tracking-wider text-cohere-softcoral flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-cohere-softcoral animate-pulse"></span> Available May 2027 • 6-Mo Internship
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Quiet Affiliation Strip (Cohere trust-logo-strip pattern) -->
      <div class="max-w-7xl mx-auto px-6 pb-14 md:px-12 md:pb-16">
        <div class="border-t border-cohere-hairline/80 pt-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-cohere-muted shrink-0">
            Academic &amp; Industry Background
          </span>
          <div class="flex flex-wrap items-center gap-x-10 gap-y-3 text-cohere-slate">
            <span class="font-display text-[17px] tracking-tight text-cohere-nearblack/80">ESIEA</span>
            <span class="font-display text-[17px] tracking-tight text-cohere-nearblack/80">SKEMA Business School</span>
            <span class="font-display text-[17px] tracking-tight text-cohere-nearblack/80">SeoulTech</span>
            <span class="font-display text-[17px] tracking-tight text-cohere-nearblack/80">NG Metrics</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Band 2: Core Capabilities (Cohere Deep Enterprise Green Full-Bleed Band) -->
    <section class="w-full bg-cohere-green text-white">
      <div class="max-w-7xl mx-auto px-6 py-24 md:px-12 md:py-28">
        <div class="max-w-3xl mb-16 space-y-4">
          <span class="font-mono text-[12px] uppercase tracking-[0.2em] text-cohere-softcoral block">
            Core Engineering Pillars
          </span>
          <h2 class="font-display text-[40px] md:text-[52px] leading-[1.05] tracking-[-1px] text-white">
            Built for reliability, from physical signal to enterprise scale.
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Pillar 1 -->
          <div class="bg-white/[0.04] border border-white/15 rounded-md p-8 flex flex-col justify-between space-y-8">
            <div class="space-y-5">
              <svg class="w-8 h-8 text-cohere-softcoral" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12h4l3-7 4 14 3-7h6" />
              </svg>
              <h3 class="font-display text-[24px] leading-[1.25] tracking-[-0.24px] text-white">
                Explainable ML & Calibration
              </h3>
              <p class="font-body text-[15px] leading-[1.6] text-white/75">
                Designing 1D CNNs and time-series triage pipelines backed by Monte Carlo Dropout uncertainty, Temperature Scaling, and Grad-CAM / SHAP consensus.
              </p>
            </div>
            <div class="pt-5 border-t border-white/10 font-mono text-[11px] uppercase tracking-wider text-white/60">
              PyTorch · Keras · XAI · ECE
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="bg-white/[0.04] border border-white/15 rounded-md p-8 flex flex-col justify-between space-y-8">
            <div class="space-y-5">
              <svg class="w-8 h-8 text-cohere-softcoral" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <path d="M10 6.5h4M17.5 10v4M14 17.5h-4M6.5 14v-4" />
              </svg>
              <h3 class="font-display text-[24px] leading-[1.25] tracking-[-0.24px] text-white">
                Enterprise Data & AI Agents
              </h3>
              <p class="font-body text-[15px] leading-[1.6] text-white/75">
                Connecting modern LLMs to legacy enterprise infrastructure with zero data leakage—through SSO impersonation proxies, MDX/MOLAP translation, and deterministic guardrails.
              </p>
            </div>
            <div class="pt-5 border-t border-white/10 font-mono text-[11px] uppercase tracking-wider text-white/60">
              LLM Agents · SQL · MDX · Governance
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="bg-white/[0.04] border border-white/15 rounded-md p-8 flex flex-col justify-between space-y-8">
            <div class="space-y-5">
              <svg class="w-8 h-8 text-cohere-softcoral" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="6" y="6" width="12" height="12" rx="1.5" />
                <path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />
              </svg>
              <h3 class="font-display text-[24px] leading-[1.25] tracking-[-0.24px] text-white">
                Edge Telemetry & Cloud Systems
              </h3>
              <p class="font-body text-[15px] leading-[1.6] text-white/75">
                Bridging hardware-constrained telemetry (MAVLink, 4G, sensor buses) with deterministic cloud infrastructure provisioned via Docker, Kubernetes, and Terraform.
              </p>
            </div>
            <div class="pt-5 border-t border-white/10 font-mono text-[11px] uppercase tracking-wider text-white/60">
              C/C++ · IoT · GCP · Kubernetes
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Band 3: Experience Timeline (Canvas White) -->
    <section class="w-full bg-cohere-canvas">
      <div class="max-w-7xl mx-auto px-6 py-24 md:px-12 md:py-32">
        <div class="max-w-4xl">
          <h2 class="font-display text-[48px] leading-[1.1] tracking-[-0.48px] text-cohere-nearblack mb-16 border-b border-cohere-hairline pb-8">
            Trajectory
          </h2>
          
          <div class="relative pl-8 md:pl-0">
            <div class="hidden md:block absolute left-[120px] top-2 bottom-0 w-[1px] bg-cohere-hairline"></div>
            
            <div class="space-y-16">
              
              <!-- Item 1 -->
              <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
                <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-cohere-nearblack rounded-full ring-4 ring-cohere-canvas"></div>
                <div class="md:w-[100px] shrink-0 pt-1">
                  <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2026 - PRES</span>
                </div>
                <div class="flex-grow">
                  <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Dual Degree</h3>
                  <p class="font-body text-[16px] leading-[1.6] text-cohere-ink mb-4 max-w-2xl opacity-90">
                    SKEMA Business School & ESIEA. MSc Artificial Intelligence for Business Transformation (AIBT).
                  </p>
                </div>
              </div>
              
              <!-- Item 2 -->
              <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
                <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-white border border-cohere-hairline rounded-full ring-4 ring-cohere-canvas"></div>
                <div class="md:w-[100px] shrink-0 pt-1">
                  <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2026</span>
                </div>
                <div class="flex-grow">
                  <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">AI & Data Engineering Intern (5 months)</h3>
                  <p class="font-body text-[16px] leading-[1.6] text-cohere-ink mb-4 max-w-2xl opacity-90">
                    NG Metrics. Architected an enterprise SSO impersonation proxy and an in-Excel LLM agent translating natural language into MDX queries over legacy MOLAP cubes with zero data leakage. Engineered automated financial reporting pipelines using PowerBI for SMEs.
                  </p>
                </div>
              </div>

              <!-- Item 3 -->
              <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
                <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-white border border-cohere-hairline rounded-full ring-4 ring-cohere-canvas"></div>
                <div class="md:w-[100px] shrink-0 pt-1">
                  <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2024</span>
                </div>
                <div class="flex-grow">
                  <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Academic Exchange (ML & Quantum)</h3>
                  <p class="font-body text-[16px] leading-[1.6] text-cohere-ink mb-4 max-w-2xl opacity-90">
                    Seoul National University of Science and Technology (Seoul, South Korea). Completed intensive coursework in Machine Learning and Quantum Computing.
                  </p>
                </div>
              </div>
              
              <!-- Item 4 -->
              <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
                <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-white border border-cohere-hairline rounded-full ring-4 ring-cohere-canvas"></div>
                <div class="md:w-[100px] shrink-0 pt-1">
                  <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2021 - 2027</span>
                </div>
                <div class="flex-grow">
                  <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Engineering Degree in Computer Science</h3>
                  <p class="font-body text-[16px] leading-[1.6] text-cohere-ink max-w-2xl opacity-90">
                    ESIEA (École Supérieure d'Informatique, Électronique, Automatique). Focused on the intersection of embedded systems and artificial intelligence.
                  </p>
                </div>
              </div>
              
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Band 4: Featured Projects (Cohere Soft Stone Full-Bleed Band) -->
    <section class="w-full bg-cohere-stone border-t border-cohere-hairline/80">
      <div class="max-w-7xl mx-auto px-6 py-24 md:px-12 md:py-32">
        <div class="flex flex-col md:flex-row justify-between items-baseline mb-16 border-b border-cohere-hairline pb-8">
          <h2 class="font-display text-[48px] leading-[1.1] tracking-[-0.48px] text-cohere-nearblack">
            Selected Works
          </h2>
          <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/projects`} class="font-body text-[14px] text-cohere-ink hover:text-cohere-blue underline underline-offset-4 decoration-cohere-hairline hover:decoration-cohere-ink transition-colors mt-4 md:mt-0">
            View All Projects &rarr;
          </a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-10">
          {featuredProjects.map(project => (
            <ProjectCard 
              title={project.data.title}
              description={project.data.description}
              tags={project.data.techStack.slice(0, 3)}
              imageUrl={project.data.coverImage}
              url={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/projects/${project.id.replace('en/', '')}`}
            />
          ))}
        </div>
      </div>
    </section>

  </div>

  <script define:vars={{ base: import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '') }}>
    // Automatic Language Detection (runs only on first visit)
    const hasVisited = localStorage.getItem('languagePreferenceSet');
    
    if (!hasVisited) {
      // Mark as visited so we don't trap the user in a redirect loop if they manually switch back to English
      localStorage.setItem('languagePreferenceSet', 'true');
      
      const browserLang = navigator.language || navigator.userLanguage;
      if (browserLang.toLowerCase().startsWith('fr')) {
        window.location.replace(`${base}/fr/`);
      }
    }
  </script>
</BaseLayout>
