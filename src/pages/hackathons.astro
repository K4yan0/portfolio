---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="Hackathons | System." description="Hackathons and competitions.">
  <div class="space-y-16">
    <header class="border-b border-cohere-hairline pb-12 max-w-4xl">
      <h1 class="font-display text-[48px] md:text-[64px] tracking-tight text-cohere-nearblack mb-4">Hackathons</h1>
      <p class="font-body text-[20px] text-cohere-muted">Competitions, intensive building sessions, and innovation sprints.</p>
    </header>

    <div class="py-12 flex flex-col items-center justify-center text-center space-y-6 bg-white border border-cohere-hairline rounded-lg">
      <h2 class="font-display text-[24px] tracking-tight text-cohere-nearblack">No hackathons yet</h2>
      <p class="font-body text-[16px] text-cohere-ink opacity-80 max-w-md mx-auto">
        I am actively looking for opportunities to participate in hackathons. Check back later to see my upcoming and past competition projects!
      </p>
    </div>
  </div>
</BaseLayout>
