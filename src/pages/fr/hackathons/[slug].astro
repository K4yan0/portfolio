---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../components/BaseLayout.astro';
import { Tag } from '../../../components/Tag';
import { Button } from '../../../components/Button';

export async function getStaticPaths() {
  const allHackathons = await getCollection('hackathons');
  const frHackathons = allHackathons.filter(h => h.id.startsWith('fr/') || h.id.startsWith('fr\\'));

  return frHackathons.map(entry => ({
    params: { slug: entry.id.replace(/^fr[\\/]/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const h2Headings = headings.filter((h) => h.depth === 2);
const tocHeadings = h2Headings.length >= 3
  ? h2Headings
  : headings.filter((h) => h.depth === 2 || h.depth === 3);
const wordCount = (entry.body || '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${entry.data.title} | Hackathon`} description={entry.data.description} image={entry.data.coverImage}>
  <div class="w-full max-w-6xl mx-auto flex flex-col lg:flex-row justify-start gap-12 lg:gap-16 xl:gap-20 items-start">

    <!-- Sidebar Hackathon Sticky -->
    <aside class="hidden lg:block w-[240px] shrink-0 sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pr-2 self-start">
      <div class="space-y-9">
        <!-- Retour aux Hackathons -->
        <a href={`${base}/fr/hackathons`} class="group inline-flex items-center gap-2 text-cohere-slate hover:text-cohere-nearblack transition-colors font-body text-[14px] no-underline">
          <svg class="w-4 h-4 transform transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Tous les hackathons
        </a>

        <!-- Sommaire dynamique -->
        {tocHeadings.length >= 2 && (
          <div class="space-y-4">
            <span class="font-mono text-[11px] uppercase tracking-widest text-cohere-muted block">
              Sommaire
            </span>
            <nav class="flex flex-col space-y-3 border-l border-cohere-hairline pl-4 font-mono text-[12px] leading-snug">
              {tocHeadings.map((heading, idx) => (
                <a
                  href={`#${heading.slug}`}
                  data-target={heading.slug}
                  class={`hackathon-toc-link transition-colors hover:text-cohere-nearblack no-underline ${
                    idx === 0
                      ? 'text-cohere-nearblack font-medium border-l-2 border-cohere-nearblack -ml-[17px] pl-[15px]'
                      : 'text-cohere-slate'
                  }`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- Aperçu rapide -->
        <div class="pt-7 border-t border-cohere-hairline space-y-4">
          <span class="font-mono text-[11px] uppercase tracking-widest text-cohere-muted block">
            Aperçu
          </span>
          <dl class="space-y-3 text-[13px]">
            {entry.data.event && (
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-wider text-cohere-muted">Événement</dt>
                <dd class="font-body text-cohere-nearblack mt-0.5">{entry.data.event}</dd>
              </div>
            )}
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-wider text-cohere-muted">Date &amp; Lieu</dt>
              <dd class="font-body text-cohere-nearblack mt-0.5">
                {entry.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })} · {entry.data.location}
              </dd>
            </div>
            {entry.data.duration && (
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-wider text-cohere-muted">Format</dt>
                <dd class="font-body text-cohere-nearblack mt-0.5">{entry.data.duration}</dd>
              </div>
            )}
            {entry.data.role && (
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-wider text-cohere-muted">Rôle</dt>
                <dd class="font-body text-cohere-nearblack mt-0.5">{entry.data.role}</dd>
              </div>
            )}
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-wider text-cohere-muted">Lecture</dt>
              <dd class="font-body text-cohere-nearblack mt-0.5">{readingTime} min de lecture</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-wider text-cohere-muted">Stack clé</dt>
              <dd class="font-body text-cohere-nearblack mt-0.5">{entry.data.techStack.slice(0, 4).join(' · ')}</dd>
            </div>
          </dl>
        </div>
      </div>
    </aside>

    <!-- Contenu Principal de l'Étude de Cas -->
    <article class="flex-1 min-w-0 max-w-3xl w-full">
      <!-- Lien Retour Mobile -->
      <div class="lg:hidden mb-8">
        <a href={`${base}/fr/hackathons`} class="group inline-flex items-center gap-2 text-cohere-slate hover:text-cohere-nearblack transition-colors font-body text-[14px] no-underline">
          <svg class="w-4 h-4 transform transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Tous les hackathons
        </a>
      </div>

      <header class="mb-16 space-y-8 border-b border-cohere-hairline pb-12">
        {entry.data.coverImage && (
          <div class="w-full aspect-video rounded-[22px] overflow-hidden border border-cohere-hairline bg-cohere-stone">
            <img src={entry.data.coverImage} alt={entry.data.title} class="w-full h-full object-cover" />
          </div>
        )}

        {entry.data.hostLogos && entry.data.hostLogos.length > 0 && (
          <div class="flex flex-wrap items-center justify-between gap-4 px-6 py-4 rounded-md border border-cohere-hairline bg-cohere-stone/40">
            <div class="flex flex-wrap items-center gap-5">
              {entry.data.hostLogos.map((logo, idx) => (
                <>
                  <img
                    src={logo.src}
                    alt={logo.alt}
                    class="h-5 md:h-6 w-auto object-contain"
                  />
                  {idx < entry.data.hostLogos!.length - 1 && (
                    <span class="font-mono text-[12px] text-cohere-muted select-none">&times;</span>
                  )}
                </>
              ))}
            </div>
            <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-cohere-muted">
              Organisé par
            </span>
          </div>
        )}

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          {entry.data.event && (
            <span class="font-mono text-[12px] uppercase tracking-[0.18em] text-cohere-coral flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cohere-coral"></span>
              {entry.data.event}
            </span>
          )}
          <span class="font-mono text-[12px] text-cohere-muted uppercase tracking-wider">
            {entry.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          <span class="font-mono text-[12px] text-cohere-muted uppercase tracking-wider">
            · {readingTime} min de lecture
          </span>
        </div>

        <div class="space-y-5">
          <h1 class="font-display text-[40px] md:text-[56px] leading-[1.04] tracking-[-1.1px] text-cohere-nearblack">
            {entry.data.title}
          </h1>
          <p class="font-body text-[18px] md:text-[20px] leading-[1.55] text-cohere-muted">
            {entry.data.description}
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-6 pt-2">
          <div class="flex flex-wrap gap-2">
            {entry.data.techStack.map((tech) => (
              <Tag variant="tech" label={tech} />
            ))}
          </div>
          {entry.data.githubUrl && (
            <Button variant="outline" href={entry.data.githubUrl}>Code Source</Button>
          )}
        </div>
      </header>

      <div class="prose prose-lg max-w-none
        prose-headings:font-display prose-headings:text-cohere-nearblack prose-headings:tracking-tight prose-headings:scroll-mt-28
        prose-h1:text-[44px] prose-h1:tracking-[-0.48px] prose-h1:leading-[1.2]
        prose-h2:text-[30px] prose-h2:tracking-[-0.32px] prose-h2:leading-[1.2]
        prose-h3:text-[22px] prose-h3:leading-[1.3]
        prose-p:font-body prose-p:text-cohere-ink prose-p:text-[18px] prose-p:leading-[1.6]
        prose-a:text-cohere-blue prose-a:underline prose-a:underline-offset-4 prose-a:decoration-cohere-hairline hover:prose-a:decoration-cohere-blue transition-colors
        prose-code:font-mono prose-code:text-[14px] prose-code:bg-cohere-stone prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-code:border prose-code:border-cohere-hairline before:content-none after:content-none
        prose-pre:border prose-pre:border-cohere-hairline prose-pre:rounded-lg prose-pre:bg-cohere-nearblack
        prose-strong:text-cohere-nearblack prose-strong:font-medium
        prose-hr:border-cohere-hairline
        prose-blockquote:border-l-cohere-hairline prose-blockquote:border-l-[2px] prose-blockquote:text-cohere-slate prose-blockquote:font-normal prose-blockquote:not-italic
        prose-ul:font-body prose-ul:text-cohere-ink prose-ol:font-body prose-ol:text-cohere-ink
        prose-li:my-1
        prose-table:text-[15px]
      ">
        <Content />
      </div>
    </article>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const tocLinks = document.querySelectorAll('.hackathon-toc-link');
      if (!tocLinks.length) return;

      const targets = Array.from(tocLinks)
        .map((link) => document.getElementById(link.getAttribute('data-target') || ''))
        .filter((el): el is HTMLElement => Boolean(el));

      if (!targets.length) return;

      const setActive = (id: string) => {
        tocLinks.forEach((link) => {
          if (link.getAttribute('data-target') === id) {
            link.classList.remove('text-cohere-slate');
            link.classList.add('text-cohere-nearblack', 'font-medium', 'border-l-2', 'border-cohere-nearblack', '-ml-[17px]', 'pl-[15px]');
          } else {
            link.classList.remove('text-cohere-nearblack', 'font-medium', 'border-l-2', 'border-cohere-nearblack', '-ml-[17px]', 'pl-[15px]');
            link.classList.add('text-cohere-slate');
          }
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.target.id) {
              setActive(entry.target.id);
            }
          });
        },
        { rootMargin: '-15% 0px -70% 0px' }
      );

      targets.forEach((el) => observer.observe(el));
    });
  </script>
</BaseLayout>
