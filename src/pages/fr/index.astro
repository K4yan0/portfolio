---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import { Button } from '../../components/Button';
import { ProjectCard } from '../../components/ProjectCard';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.id.startsWith('fr/'))
  .sort((a, b) => b.data.launchDate.valueOf() - a.data.launchDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title="System. | Portfolio Développeur" description="Un portfolio d'ingénierie minimaliste.">
  <div class="space-y-40">
    
    <!-- Hero Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <div class="lg:col-span-7 space-y-10">
        <h1 class="font-display text-[64px] md:text-[80px] leading-[0.95] tracking-[-1.92px] text-cohere-nearblack">
          Ingénierie & <br class="hidden md:block"/> Intelligence.
        </h1>
        <p class="font-body text-[18px] md:text-[20px] leading-[1.6] text-cohere-ink max-w-xl opacity-90">
          Étudiant ingénieur en dernière année, spécialisé en Systèmes Embarqués et Intelligence Artificielle. Actuellement en double diplôme à l'ESIEA et SKEMA Business School (MSc AIBT).
        </p>
        <div class="flex flex-wrap items-center gap-6 pt-4">
          <Button variant="primary" href={`${import.meta.env.BASE_URL}fr/projects`}>Voir les Projets</Button>
          <Button variant="secondary" href={`${import.meta.env.BASE_URL}fr/about`}>À propos de moi</Button>
        </div>
      </div>
      
      <div class="lg:col-span-5 relative group hidden md:block">
          <div class="relative w-full aspect-square md:aspect-[4/5] bg-cohere-stone overflow-hidden shadow-2xl">
            <img 
              src={`${import.meta.env.BASE_URL}images/hero.jpg`} 
              alt="Swan - Développeur" 
              class="w-full h-full object-cover grayscale opacity-90 transition-all duration-1000 hover:grayscale-0 hover:opacity-100 hover:scale-105"
            />
          <div class="absolute bottom-4 left-4 right-4 bg-cohere-nearblack/90 backdrop-blur-md border border-cohere-hairline/20 rounded-lg p-4 flex items-center justify-between">
            <span class="font-mono text-[11px] uppercase tracking-wider text-white">System.Status</span>
            <span class="font-mono text-[11px] uppercase tracking-wider text-cohere-softcoral flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cohere-softcoral animate-pulse"></span> Recherche stage 2027
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="max-w-4xl">
      <h2 class="font-display text-[48px] leading-[1.1] tracking-[-0.48px] text-cohere-nearblack mb-16 border-b border-cohere-hairline pb-8">
        Parcours
      </h2>
      
      <div class="relative pl-8 md:pl-0">
        <div class="hidden md:block absolute left-[120px] top-2 bottom-0 w-[1px] bg-cohere-hairline"></div>
        
        <div class="space-y-16">
          
          <!-- Item 1 -->
          <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
            <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-cohere-nearblack rounded-full ring-4 ring-cohere-canvas"></div>
            <div class="md:w-[100px] shrink-0 pt-1">
              <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2026 - PRÉS</span>
            </div>
            <div class="flex-grow">
              <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Double Diplôme (MSc AIBT)</h3>
              <p class="font-body text-[16px] leading-[1.6] text-cohere-ink mb-4 max-w-2xl opacity-90">
                SKEMA Business School & ESIEA. Master of Science en Artificial Intelligence for Business Transformation.
              </p>
            </div>
          </div>
          
          <!-- Item 2 -->
          <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
            <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-white border border-cohere-hairline rounded-full ring-4 ring-cohere-canvas"></div>
            <div class="md:w-[100px] shrink-0 pt-1">
              <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2026</span>
            </div>
            <div class="flex-grow">
              <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Stagiaire Ingénieur Data & IA</h3>
              <p class="font-body text-[16px] leading-[1.6] text-cohere-ink mb-4 max-w-2xl opacity-90">
                NG Metrics (anciennement KPIWeb). Développement d'un proxy de connexion avec impersonnalisation, d'un Agent IA pour Excel, et d'une IA d'analyse/reporting comptable sous PowerBI pour les PME.
              </p>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
            <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-white border border-cohere-hairline rounded-full ring-4 ring-cohere-canvas"></div>
            <div class="md:w-[100px] shrink-0 pt-1">
              <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2024</span>
            </div>
            <div class="flex-grow">
              <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Échange Académique (ML & Quantique)</h3>
              <p class="font-body text-[16px] leading-[1.6] text-cohere-ink mb-4 max-w-2xl opacity-90">
                Seoul National University of Science and Technology (Séoul, Corée du Sud). Semestre intensif avec des cours de Machine Learning et d'Informatique Quantique.
              </p>
            </div>
          </div>
          
          <!-- Item 4 -->
          <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
            <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-white border border-cohere-hairline rounded-full ring-4 ring-cohere-canvas"></div>
            <div class="md:w-[100px] shrink-0 pt-1">
              <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2021 - 2027</span>
            </div>
            <div class="flex-grow">
              <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Diplôme d'Ingénieur Informatique</h3>
              <p class="font-body text-[16px] leading-[1.6] text-cohere-ink max-w-2xl opacity-90">
                ESIEA. Spécialisation en Systèmes Embarqués. J'ai choisi cette filière car l'IA et les systèmes embarqués seront intimement liés dans le futur.
              </p>
            </div>
          </div>
          
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section>
      <div class="flex flex-col md:flex-row justify-between items-baseline mb-16 border-b border-cohere-hairline pb-8">
        <h2 class="font-display text-[48px] leading-[1.1] tracking-[-0.48px] text-cohere-nearblack">
          Projets Récents
        </h2>
        <a href={`${import.meta.env.BASE_URL}fr/projects`} class="font-body text-[14px] text-cohere-ink hover:text-cohere-blue underline underline-offset-4 decoration-cohere-hairline hover:decoration-cohere-ink transition-colors mt-4 md:mt-0">
          Voir tous les projets &rarr;
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-10">
        {featuredProjects.map(project => (
          <ProjectCard 
            title={project.data.title}
            description={project.data.description}
            tags={project.data.techStack.slice(0, 3)}
            imageUrl={project.data.coverImage}
            url={`${import.meta.env.BASE_URL}fr/projects/${project.id.replace('fr/', '')}`}
          />
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
