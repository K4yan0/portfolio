---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  fullBleed?: boolean;
  image?: string;
}

const { title = "Developer | Portfolio", description = "A minimalist and premium developer portfolio.", fullBleed = false, image } = Astro.props;
const lang = Astro.currentLocale || 'en';
const sysBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const langPrefix = lang === 'fr' ? '/fr' : '';
const base = `${sysBase}${langPrefix}`;
const ogImageUrl = new URL(image || `${sysBase}/images/hero.jpg`, Astro.site || Astro.url);

// Compute the path to switch language correctly
const currentPath = Astro.url.pathname;
const pathWithoutSysBase = currentPath.startsWith(sysBase) 
  ? currentPath.slice(sysBase.length) || '/' 
  : currentPath;
  
const switchLangPath = lang === 'en' 
  ? `${sysBase}/fr${pathWithoutSysBase.endsWith('/') && pathWithoutSysBase.length > 1 ? pathWithoutSysBase.slice(0, -1) : pathWithoutSysBase}` 
  : `${sysBase}${pathWithoutSysBase.replace(/^\/fr/, '') || '/'}`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${sysBase}/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${sysBase}/favicon.ico`} />
    <link rel="shortcut icon" href={`${sysBase}/favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    
    <ClientRouter />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- KaTeX for Math Formulas -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.8/katex.min.css" crossorigin="anonymous">
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.8/katex.min.js" crossorigin="anonymous"></script>
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.8/contrib/auto-render.min.js" crossorigin="anonymous"></script>
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        if (window.renderMathInElement) {
          renderMathInElement(document.body, {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false}
            ],
            throwOnError: false
          });
        }
      });
    </script>

    <!-- Mermaid JS via CDN -->
    <script is:inline type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
      mermaid.initialize({ startOnLoad: false, theme: 'default' });
      
      document.addEventListener('astro:page-load', async () => {
        const blocks = document.querySelectorAll('pre, .mermaid');
        for (const block of blocks) {
          const text = block.textContent.trim();
          if ((text.startsWith('flowchart') || text.startsWith('sequenceDiagram') || text.startsWith('graph')) && !block.dataset.rendered) {
            block.dataset.rendered = "true";
            const id = `mermaid-graph-${Math.random().toString(36).substring(2, 9)}`;
            try {
              const { svg } = await mermaid.render(id, block.textContent);
              const div = document.createElement('div');
              div.className = 'mermaid-diagram flex justify-center my-8 w-full overflow-x-auto';
              div.innerHTML = svg;
              block.replaceWith(div);
            } catch (e) {
              console.error('Mermaid render error:', e);
            }
          }
        }
      });
    </script>
    
    <!-- GitHub Alerts Support -->
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('blockquote').forEach(bq => {
          const p = bq.querySelector('p');
          if (p && p.innerHTML.includes('[!IMPORTANT]')) {
            p.innerHTML = p.innerHTML.replace('[!IMPORTANT]', '<strong class="text-cohere-coral uppercase tracking-wider text-[12px] flex items-center gap-2 mb-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg> IMPORTANT</strong>');
            bq.className = 'border-l-4 border-cohere-coral bg-[#fff0ed] p-4 my-6 text-cohere-ink rounded-r text-sm';
          }
        });
      });
    </script>
  </head>
  <body class="bg-cohere-canvas text-cohere-ink font-body min-h-screen flex flex-col selection:bg-cohere-blue selection:text-white antialiased">
    <header class="sticky top-0 z-50 w-full border-b border-cohere-hairline/80 bg-cohere-canvas/90 backdrop-blur-md transition-all">
      <div class="w-full px-6 py-5 md:px-12 flex items-center justify-between">
        <div class="md:w-1/4">
          <a href={`${base}/`} class="inline-flex items-center gap-2.5 font-display font-medium text-xl tracking-tight text-cohere-black hover:opacity-80 transition-opacity no-underline">
            <img src={`${sysBase}/favicon.svg`} alt="" class="w-9 h-9 object-contain" />
            <span>Swan<span class="text-cohere-coral">.</span></span>
          </a>
        </div>
        
        <nav class="hidden md:flex md:w-1/2 justify-center space-x-6 md:space-x-8">
          <a href={`${base}/`} class="font-body text-[14px] text-cohere-ink hover:text-cohere-blue transition-colors underline-offset-4 hover:underline">
            {lang === 'fr' ? 'Accueil' : 'Home'}
          </a>
          <a href={`${base}/about`} class="font-body text-[14px] text-cohere-ink hover:text-cohere-blue transition-colors underline-offset-4 hover:underline">
            {lang === 'fr' ? 'À propos' : 'About'}
          </a>
          <a href={`${base}/projects`} class="font-body text-[14px] text-cohere-ink hover:text-cohere-blue transition-colors underline-offset-4 hover:underline">
            {lang === 'fr' ? 'Projets' : 'Projects'}
          </a>
          <a href={`${base}/blog`} class="font-body text-[14px] text-cohere-ink hover:text-cohere-blue transition-colors underline-offset-4 hover:underline">
            Blog
          </a>
        </nav>
        
        <div class="md:w-1/4 flex justify-end items-center gap-5 md:gap-6">
          <a href={switchLangPath} class="font-mono text-[13px] font-medium text-cohere-slate hover:text-cohere-blue transition-colors uppercase tracking-wider">
            {lang === 'en' ? 'FR' : 'EN'}
          </a>
          <a href={`${base}/contact`} class="hidden md:inline-block bg-cohere-nearblack text-white font-body text-[14px] font-medium px-6 py-2 rounded-pill hover:bg-black transition-colors">
            Contact
          </a>
          <button
            id="mobile-menu-toggle"
            type="button"
            aria-label={lang === 'fr' ? 'Ouvrir le menu' : 'Toggle menu'}
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="md:hidden inline-flex items-center justify-center p-2 -mr-2 text-cohere-ink hover:text-cohere-black transition-colors"
          >
            <svg id="mobile-menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg id="mobile-menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <nav id="mobile-menu" class="hidden md:hidden border-t border-cohere-hairline/80 bg-cohere-canvas px-6 py-6">
        <div class="flex flex-col space-y-5">
          <a href={`${base}/`} class="font-body text-[16px] text-cohere-ink hover:text-cohere-blue transition-colors">
            {lang === 'fr' ? 'Accueil' : 'Home'}
          </a>
          <a href={`${base}/about`} class="font-body text-[16px] text-cohere-ink hover:text-cohere-blue transition-colors">
            {lang === 'fr' ? 'À propos' : 'About'}
          </a>
          <a href={`${base}/projects`} class="font-body text-[16px] text-cohere-ink hover:text-cohere-blue transition-colors">
            {lang === 'fr' ? 'Projets' : 'Projects'}
          </a>
          <a href={`${base}/blog`} class="font-body text-[16px] text-cohere-ink hover:text-cohere-blue transition-colors">
            Blog
          </a>
          <div class="pt-3 border-t border-cohere-hairline/60">
            <a href={`${base}/contact`} class="inline-flex w-full items-center justify-center bg-cohere-nearblack text-white font-body text-[14px] font-medium px-6 py-3 rounded-pill hover:bg-black transition-colors">
              Contact
            </a>
          </div>
        </div>
      </nav>
    </header>

    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('mobile-menu-icon-open');
        const iconClose = document.getElementById('mobile-menu-icon-close');

        if (!toggle || !menu || toggle.dataset.bound) return;
        toggle.dataset.bound = 'true';

        toggle.addEventListener('click', () => {
          const isHidden = menu.classList.toggle('hidden');
          toggle.setAttribute('aria-expanded', String(!isHidden));
          iconOpen?.classList.toggle('hidden', !isHidden);
          iconClose?.classList.toggle('hidden', isHidden);
        });
      });
    </script>

    <main class={fullBleed ? "flex-grow w-full" : "flex-grow w-full max-w-7xl mx-auto px-6 py-16 md:px-12 md:py-24"}>
      <slot />
    </main>

    <footer class={`w-full bg-cohere-nearblack text-white px-6 py-16 md:px-12 ${fullBleed ? '' : 'mt-24'}`}>
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start">
        <div class="mb-12 md:mb-0">
          <a href={`${base}/`} class="inline-flex items-center gap-2.5 font-display text-2xl tracking-tight text-white mb-4 no-underline">
            <img src={`${sysBase}/favicon.svg`} alt="" class="w-9 h-9 object-contain invert" />
            <span>Swan<span class="text-cohere-coral">.</span></span>
          </a>
          <span class="font-body text-sm text-cohere-muted block max-w-xs leading-relaxed">
            {lang === 'fr' 
              ? 'Un portfolio d\'ingénierie minimaliste conçu avec Astro et Tailwind.' 
              : 'A minimalist engineering showcase built with Astro, Tailwind, and deep focus.'}
          </span>
        </div>
        
        <div class="grid grid-cols-2 gap-16">
          <div class="flex flex-col space-y-4">
            <span class="font-mono uppercase text-[12px] tracking-wider text-cohere-muted">
              {lang === 'fr' ? 'Plateforme' : 'Platform'}
            </span>
            <a href={`${base}/projects`} class="font-body text-sm text-white hover:text-cohere-softcoral transition-colors">
              {lang === 'fr' ? 'Projets' : 'Projects'}
            </a>
            <a href={`${base}/hackathons`} class="font-body text-sm text-white hover:text-cohere-softcoral transition-colors">
              Hackathons
            </a>
            <a href={`${base}/blog`} class="font-body text-sm text-white hover:text-cohere-softcoral transition-colors">
              Blog
            </a>
          </div>
          <div class="flex flex-col space-y-4">
            <span class="font-mono uppercase text-[12px] tracking-wider text-cohere-muted">
              {lang === 'fr' ? 'Liens' : 'Connect'}
            </span>
            <a href={`${base}/contact`} class="font-body text-sm text-white hover:text-cohere-softcoral transition-colors">
              Contact
            </a>
            <a href="https://github.com/K4yan0" target="_blank" rel="noopener noreferrer" class="font-body text-sm text-white hover:text-cohere-softcoral transition-colors">GitHub</a>
          </div>
        </div>
      </div>
      
      <div class="max-w-7xl mx-auto mt-16 pt-8 border-t border-[#2a2a30] flex justify-between items-center">
        <span class="font-body text-xs text-cohere-muted">
          © {new Date().getFullYear()} {lang === 'fr' ? 'Tous droits réservés.' : 'All rights reserved.'}
        </span>
        <span class="font-body text-xs text-cohere-muted flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span> {lang === 'fr' ? 'Systèmes opérationnels' : 'Systems Operational'}
        </span>
      </div>
    </footer>
  </body>
</html>
