---
import BaseLayout from '../../components/BaseLayout.astro';
import { Button } from '../../components/Button';
---
<BaseLayout title="Contact | System." description="Get in touch.">
  <!-- Following Cohere's contact-form-card pattern on a dark background -->
  <div class="max-w-6xl mx-auto rounded-[22px] overflow-hidden border border-cohere-hairline flex flex-col md:flex-row shadow-sm">
    <div class="w-full md:w-1/2 p-12 md:p-20 flex flex-col justify-between bg-cohere-nearblack text-white">
      <div>
        <h1 class="font-display text-[48px] md:text-[56px] leading-[1.1] tracking-[-0.48px] mb-6">Initialiser <br/> la Connexion.</h1>
        <p class="font-body text-[18px] text-cohere-muted max-w-md leading-[1.6]">
          Je suis actuellement à l'écoute de nouvelles opportunités en architecture technique et ingénierie à fort impact.
        </p>
      </div>
      <div class="mt-20 flex flex-col space-y-8">
        <div>
          <span class="font-mono text-[12px] uppercase tracking-wider text-cohere-muted block mb-2">Canal Direct</span>
          <a href="mailto:hello@system.com" class="font-display text-[24px] tracking-tight text-white hover:text-cohere-softcoral transition-colors">hello@system.com</a>
        </div>
        
        <div class="flex gap-8 pt-8 border-t border-[#2a2a30]">
          <a href="https://github.com/K4yan0" target="_blank" rel="noopener noreferrer" class="font-mono text-[14px] uppercase tracking-wider text-white hover:text-cohere-blue transition-colors">GitHub ↗</a>
        </div>
      </div>
    </div>
    
    <div class="w-full md:w-1/2 p-12 md:p-20 bg-white">
      <form class="space-y-8" action="https://formspree.io/f/VOTRE_ID_FORMSPREE" method="POST">
        <div class="space-y-2">
          <label class="font-mono text-[12px] uppercase tracking-wider text-cohere-slate">Nom</label>
          <input type="text" name="name" required class="w-full font-body text-[16px] px-4 py-3 border border-cohere-hairline rounded-sm focus:outline-none focus:border-cohere-focusviolet focus:ring-1 focus:ring-cohere-focusviolet transition-all bg-transparent" placeholder="Jane Doe" />
        </div>
        
        <div class="space-y-2">
          <label class="font-mono text-[12px] uppercase tracking-wider text-cohere-slate">Email</label>
          <input type="email" name="email" required class="w-full font-body text-[16px] px-4 py-3 border border-cohere-hairline rounded-sm focus:outline-none focus:border-cohere-focusviolet focus:ring-1 focus:ring-cohere-focusviolet transition-all bg-transparent" placeholder="jane@entreprise.com" />
        </div>
        
        <div class="space-y-2">
          <label class="font-mono text-[12px] uppercase tracking-wider text-cohere-slate">Message</label>
          <textarea rows="4" name="message" required class="w-full font-body text-[16px] px-4 py-3 border border-cohere-hairline rounded-sm focus:outline-none focus:border-cohere-focusviolet focus:ring-1 focus:ring-cohere-focusviolet transition-all bg-transparent resize-none" placeholder="Comment pouvons-nous collaborer ?"></textarea>
        </div>
        
        <Button variant="primary" className="w-full">Envoyer le Message</Button>
      </form>
    </div>
  </div>
</BaseLayout>
