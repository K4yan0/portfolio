---
import BaseLayout from '../../components/BaseLayout.astro';
import { Tag } from '../../components/Tag';
import { CertificationCard } from '../../components/CertificationCard';

const skillCategories = [
  {
    name: "IA & Machine Learning",
    skills: ["Machine Learning", "Deep Learning", "Keras / PyTorch", "Scikit-learn", "IA Explicable (Grad-CAM, SHAP)", "Calibration de Modèles (ECE)", "Orchestration & Prompting LLM"]
  },
  {
    name: "Ingénierie des Données & Analytics",
    skills: ["Pipelines de Données", "SQL Server", "MOLAP / MDX", "PowerBI", "Traitement de Séries Temporelles (lightkurve, BLS)", "Modélisation de Données"]
  },
  {
    name: "Cloud, DevOps & Systèmes",
    skills: ["GCP (Google Cloud)", "Docker", "Kubernetes", "Terraform", "Git & Pipelines CI/CD"]
  },
  {
    name: "Systèmes Embarqués & Socle",
    skills: ["Python", "C/C++", "Télémétrie IoT (MAVLink, 4G)", "Interfaces Capteurs (UART, I2C, SPI)", "Intégration Matérielle"]
  },
  {
    name: "Méthodologies & Langues",
    skills: ["Agile / Scrum", "Français (Natif)", "Anglais (Professionnel / Fluide)"]
  }
];

// Certifications Actives (configuré avec 1 carte pour le moment, prêt à évoluer)
const certifications = [
  {
    title: "Ingénierie des Données & Architecture Cloud",
    issuer: "Fournisseur Cloud & Data",
    issueDate: "2025",
    expiryDate: "Active",
    credentialId: "CERT-DE-01",
    verificationUrl: "https://www.credly.com",
    badgeUrl: "", // Ajoutez le chemin de l'image (ex: "/portfolio/images/badge.png")
    description: "Valide les compétences techniques pour concevoir, orchestrer et dimensionner des pipelines de données et des architectures cloud en environnement d'entreprise.",
    tags: ["Data Engineering", "Cloud", "Pipelines"]
  }
];
---

<BaseLayout title="À propos | Swan." description="À propos de l'ingénieur derrière les systèmes.">
  <div class="w-full max-w-6xl mx-auto flex flex-col lg:flex-row justify-start gap-12 lg:gap-16 xl:gap-20 items-start">
    
    <!-- Sidebar Sticky Minimaliste Cohere -->
    <aside class="hidden lg:block w-[240px] shrink-0 sticky top-28 self-start">
      <div class="space-y-10">
        <div class="space-y-5">
          <span class="font-mono text-[12px] uppercase tracking-widest text-cohere-muted block">
            Sommaire
          </span>
          <nav class="flex flex-col space-y-4 border-l border-cohere-hairline pl-5 font-mono text-[14px]">
            <a href="#journey" class="toc-link text-cohere-nearblack font-medium border-l-2 border-cohere-nearblack -ml-[21px] pl-[19px] hover:text-cohere-nearblack transition-colors" data-target="journey">
              Le Parcours
            </a>
            <a href="#stack" class="toc-link text-cohere-slate hover:text-cohere-nearblack transition-colors" data-target="stack">
              La Stack
            </a>
            <a href="#certifications" class="toc-link text-cohere-slate hover:text-cohere-nearblack transition-colors" data-target="certifications">
              Certifications
            </a>
          </nav>
        </div>

        <!-- En bref -->
        <div class="pt-8 border-t border-cohere-hairline space-y-4">
          <span class="font-mono text-[12px] uppercase tracking-widest text-cohere-muted block">
            En bref
          </span>
          <dl class="space-y-3.5 text-[13px]">
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-cohere-muted">Formation</dt>
              <dd class="font-body text-cohere-nearblack mt-0.5">ESIEA &amp; SKEMA (MSc AIBT)</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-cohere-muted">Postes visés</dt>
              <dd class="font-body text-cohere-nearblack mt-0.5">Ingénierie IA, Data &amp; Embarqué</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-cohere-muted">Disponibilité</dt>
              <dd class="font-body text-cohere-nearblack mt-0.5">Mai 2027 • Stage 6 mois</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-cohere-muted">Mobilité</dt>
              <dd class="font-body text-cohere-nearblack mt-0.5">France &amp; International</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-cohere-muted">Langues</dt>
              <dd class="font-body text-cohere-nearblack mt-0.5">Français (Natif), Anglais (Fluide)</dd>
            </div>
          </dl>
        </div>
      </div>
    </aside>

    <!-- Colonne Contenu Principal -->
    <div class="max-w-3xl w-full space-y-24">
      
      <!-- Hero Text -->
      <section class="space-y-8 border-b border-cohere-hairline pb-16">
        <h1 class="font-display text-[60px] md:text-[80px] leading-[0.95] tracking-[-1.92px] text-cohere-nearblack">
          Faire dialoguer signaux <br/> et intelligence.
        </h1>
        <p class="font-body text-[20px] md:text-[24px] leading-[1.5] text-cohere-ink opacity-90 max-w-2xl">
          Étudiant ingénieur en double diplôme (ESIEA / SKEMA). Je bâtis des passerelles entre le matériel embarqué bas niveau, les pipelines de données de production et l'intelligence artificielle.
        </p>
      </section>

      <!-- Sections de Contenu -->
      <div class="space-y-16">
        <!-- Le Parcours -->
        <section id="journey" class="space-y-6 scroll-mt-28">
          <h2 class="font-display text-[32px] tracking-[-0.32px] text-cohere-nearblack">Le Parcours</h2>
          <div class="font-body text-[18px] leading-[1.6] text-cohere-ink opacity-90 space-y-6">
            <p>
              Issu d'une formation exigeante axée sur les mathématiques approfondies et la physique, j'ai développé très tôt une approche rigoureuse et structurée de la résolution de problèmes. Ce parcours m'a mené à un échange académique intensif à Seoul National University of Science and Technology en Corée du Sud, dédié au Machine Learning et à l'Informatique Quantique.
            </p>
            <p>
              Au moment de choisir ma spécialisation, j'ai opté pour la convergence des <strong>Systèmes Embarqués et de l'IA</strong>. J'ai la conviction que les défis d'ingénierie les plus stimulants se situent à la frontière entre le signal physique et l'intelligence algorithmique : Edge AI, télémétrie autonome et calcul sous contraintes matérielles.
            </p>
            <p>
              Lors de mon stage de 5 mois chez <strong>NG Metrics</strong> en tant qu'ingénieur stagiaire IA & Data, j'ai répondu à un défi architectural concret : connecter des modèles de langage modernes à des architectures d'entreprise existantes sans compromettre la sécurité des données. J'ai conçu un proxy d'impersonnalisation SSO sécurisé et développé un Agent IA (complément web Excel) traduisant le langage naturel en requêtes MDX optimisées sur un cube MOLAP SQL Server—garantissant une confidentialité totale par séparation du schéma et des données.
            </p>
            <p>
              Actuellement en double diplôme (MSc AI for Business Transformation), je suis à la recherche de mon <strong>stage de fin d'études technique de 6 mois à partir de mai 2027</strong> en <strong>Ingénierie IA, Data Engineering ou IA Appliquée / Systèmes Embarqués</strong> (en France ou à l'international).
            </p>
          </div>
        </section>
        
        <!-- La Stack -->
        <section id="stack" class="space-y-10 pt-12 border-t border-cohere-hairline scroll-mt-28">
          <div>
            <h2 class="font-display text-[32px] tracking-[-0.32px] text-cohere-nearblack">La Stack</h2>
            <p class="font-body text-[16px] leading-[1.6] text-cohere-ink opacity-90 mt-2">
              Ma stack technique fait le lien entre l'exécution matérielle et l'intelligence des données.
            </p>
          </div>
          
          <div class="space-y-8">
            {skillCategories.map(category => (
              <div class="space-y-3">
                <h3 class="font-mono text-[13px] uppercase tracking-wider text-cohere-muted">{category.name}</h3>
                <div class="flex flex-wrap gap-2.5">
                  {category.skills.map(tech => (
                    <Tag variant="tech" label={tech} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Certifications -->
        <section id="certifications" class="space-y-10 pt-12 border-t border-cohere-hairline scroll-mt-28">
          <div>
            <h2 class="font-display text-[32px] tracking-[-0.32px] text-cohere-nearblack">Certifications</h2>
            <p class="font-body text-[16px] leading-[1.6] text-cohere-ink opacity-90 mt-2">
              Certifications techniques formelles attestant des compétences clés en data, cloud et machine learning.
            </p>
          </div>
          
          <div class="grid grid-cols-1 gap-6">
            {certifications.map(cert => (
              <CertificationCard 
                client:load
                title={cert.title}
                issuer={cert.issuer}
                issueDate={cert.issueDate}
                expiryDate={cert.expiryDate}
                credentialId={cert.credentialId}
                verificationUrl={cert.verificationUrl}
                badgeUrl={cert.badgeUrl}
                description={cert.description}
                tags={cert.tags}
                issuedByPrefix="Délivré par"
                verifyText="Vérifier l'Accréditation"
              />
            ))}
          </div>
        </section>
      </div>

    </div>

  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const sections = document.querySelectorAll('section[id]');
      const tocLinks = document.querySelectorAll('.toc-link');

      if (!sections.length || !tocLinks.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocLinks.forEach((link) => {
              if (link.getAttribute('data-target') === id) {
                link.classList.remove('text-cohere-slate');
                link.classList.add('text-cohere-nearblack', 'font-medium', 'border-l-2', 'border-cohere-nearblack', '-ml-[21px]', 'pl-[19px]');
              } else {
                link.classList.remove('text-cohere-nearblack', 'font-medium', 'border-l-2', 'border-cohere-nearblack', '-ml-[21px]', 'pl-[19px]');
                link.classList.add('text-cohere-slate');
              }
            });
          }
        });
      }, {
        rootMargin: '-15% 0px -70% 0px'
      });

      sections.forEach((section) => observer.observe(section));
    });
  </script>
</BaseLayout>
