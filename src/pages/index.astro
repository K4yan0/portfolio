---
import BaseLayout from '../components/BaseLayout.astro';
import { Button } from '../components/Button';
import { ProjectCard } from '../components/ProjectCard';
---

<BaseLayout title="System. | Developer Portfolio" description="A minimalist engineering showcase.">
  <div class="space-y-40">
    
    <!-- Hero Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <div class="lg:col-span-7 space-y-10">
        <h1 class="font-display text-[64px] md:text-[80px] leading-[0.95] tracking-[-1.92px] text-cohere-nearblack">
          Engineering the <br class="hidden md:block"/> invisible.
        </h1>
        <p class="font-body text-[18px] md:text-[20px] leading-[1.6] text-cohere-ink max-w-xl opacity-90">
          I build high-performance systems and strict, minimalist interfaces. Specialized in intelligent agents, robust architectures, and the relentless pursuit of simplicity.
        </p>
        <div class="flex flex-wrap items-center gap-6 pt-4">
          <Button variant="primary" href="/projects">Explore Architecture</Button>
          <Button variant="secondary" href="/about">Read Manifesto</Button>
        </div>
      </div>
      
      <div class="lg:col-span-5 relative group">
        <!-- Media Lift: 22px radius, hairline border, no shadow -->
        <div class="rounded-[22px] overflow-hidden border border-cohere-hairline bg-cohere-stone relative aspect-[4/3] w-full">
          <!-- Abstract 3D Render -->
          <img 
            src="/images/hero.jpg" 
            alt="Abstract Agent Console" 
            class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-[1.05]"
          />
          <!-- Faux UI overlay for context -->
          <div class="absolute bottom-4 left-4 right-4 bg-cohere-nearblack/90 backdrop-blur-md border border-cohere-hairline/20 rounded-lg p-4 flex items-center justify-between">
            <span class="font-mono text-[11px] uppercase tracking-wider text-white">System.Status</span>
            <span class="font-mono text-[11px] uppercase tracking-wider text-cohere-softcoral flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cohere-softcoral animate-pulse"></span> Online
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="max-w-4xl">
      <h2 class="font-display text-[48px] leading-[1.1] tracking-[-0.48px] text-cohere-nearblack mb-16 border-b border-cohere-hairline pb-8">
        Trajectory
      </h2>
      
      <div class="relative pl-8 md:pl-0">
        <!-- Vertical Line (Desktop only) -->
        <div class="hidden md:block absolute left-[120px] top-2 bottom-0 w-[1px] bg-cohere-hairline"></div>
        
        <div class="space-y-16">
          
          <!-- Item 1 -->
          <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
            <!-- Node dot (Desktop) -->
            <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-cohere-nearblack rounded-full ring-4 ring-cohere-canvas"></div>
            
            <div class="md:w-[100px] shrink-0 pt-1">
              <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2024 - PRES</span>
            </div>
            <div class="flex-grow">
              <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Senior Architect @ Volt</h3>
              <p class="font-body text-[16px] leading-[1.6] text-cohere-ink mb-4 max-w-2xl opacity-90">
                Leading the engineering of autonomous AI agent infrastructure. Designing deterministic systems within non-deterministic constraints. Reduced latency by 40%.
              </p>
            </div>
          </div>
          
          <!-- Item 2 -->
          <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
            <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-white border border-cohere-hairline rounded-full ring-4 ring-cohere-canvas"></div>
            <div class="md:w-[100px] shrink-0 pt-1">
              <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2021 - 2024</span>
            </div>
            <div class="flex-grow">
              <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">Full Stack Engineer @ OpenAI</h3>
              <p class="font-body text-[16px] leading-[1.6] text-cohere-ink mb-4 max-w-2xl opacity-90">
                Built scalable frontend architectures for high-traffic ML dashboards. Implemented severe strictness in type systems and automated the UI deployment pipeline.
              </p>
            </div>
          </div>
          
          <!-- Item 3 -->
          <div class="relative flex flex-col md:flex-row md:items-start gap-4 md:gap-16">
            <div class="hidden md:block absolute left-[117px] top-2 w-[7px] h-[7px] bg-white border border-cohere-hairline rounded-full ring-4 ring-cohere-canvas"></div>
            <div class="md:w-[100px] shrink-0 pt-1">
              <span class="font-mono text-[14px] text-cohere-muted tracking-wider">2018 - 2021</span>
            </div>
            <div class="flex-grow">
              <h3 class="font-display text-[24px] tracking-[-0.32px] text-cohere-nearblack mb-2">B.S. Computer Science</h3>
              <p class="font-body text-[16px] leading-[1.6] text-cohere-ink max-w-2xl opacity-90">
                Massachusetts Institute of Technology (MIT). Focus on distributed systems and computational logic.
              </p>
            </div>
          </div>
          
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section>
      <div class="flex flex-col md:flex-row justify-between items-baseline mb-16 border-b border-cohere-hairline pb-8">
        <h2 class="font-display text-[48px] leading-[1.1] tracking-[-0.48px] text-cohere-nearblack">
          Selected Works
        </h2>
        <a href="/projects" class="font-body text-[14px] text-cohere-ink hover:text-cohere-blue underline underline-offset-4 decoration-cohere-hairline hover:decoration-cohere-ink transition-colors mt-4 md:mt-0">
          View All Projects &rarr;
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-10">
        <!-- These components render statically via Astro -->
        <ProjectCard 
          title="Portfolio Architecture V2"
          description="A minimalist showcase emphasizing typography, massive internal padding, and strict border radii with zero drop shadows. SSG powered by Astro."
          tags={["ASTRO", "REACT", "TAILWIND CSS"]}
        />
        <ProjectCard 
          title="Volt Agent Framework"
          description="An open-source runtime for managing autonomous multi-agent systems with deterministic guarantees."
          tags={["PYTHON", "TYPESCRIPT", "DOCKER"]}
        />
      </div>
    </section>

  </div>
</BaseLayout>
