---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import { ProjectCard } from '../../components/ProjectCard';

// Only fetch English projects
const allProjects = await getCollection('projects');
console.log("DEBUG: All project IDs:", allProjects.map(p => p.id));
const projects = allProjects.filter(p => p.id.startsWith('en/') || p.id.startsWith('en\\'));
projects.sort((a, b) => b.data.launchDate.valueOf() - a.data.launchDate.valueOf());
---
<BaseLayout title="Projects | System." description="A showcase of engineered systems.">
  <div class="space-y-16">
    <header class="border-b border-cohere-hairline pb-12 max-w-4xl">
      <h1 class="font-display text-[48px] md:text-[64px] tracking-tight text-cohere-nearblack mb-4">Engineered Systems</h1>
      <p class="font-body text-[20px] text-cohere-muted">A collection of autonomous architectures, frameworks, and strict UIs.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {projects.map(project => (
        <ProjectCard 
          title={project.data.title}
          description={project.data.description}
          tags={project.data.techStack}
          imageUrl={project.data.coverImage}
          url={`/projects/${project.id.replace('en/', '')}`}
        />
      ))}
    </div>
  </div>
</BaseLayout>
