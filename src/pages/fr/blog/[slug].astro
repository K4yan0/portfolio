---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../../components/BaseLayout.astro';
import { Tag } from '../../../components/Tag';

export async function getStaticPaths() {
  const allEntries = await getCollection('blog');
  const frEntries = allEntries.filter(p => p.id.startsWith('fr/'));
  return frEntries.map(entry => ({
    params: { slug: entry.id.replace('fr/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((h) => h.depth === 2);
const wordCount = (entry.body || '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={`${entry.data.title} | Recherche`} description={entry.data.description} image={entry.data.coverImage}>
  <!-- Use w-full to push the sidebar to the left edge -->
  <div class="w-full max-w-[1600px] mx-auto px-6 lg:px-12 py-12 md:py-20 flex flex-col xl:flex-row justify-center gap-16 xl:gap-24 items-start relative">
    
    <!-- Cohere-style Sticky Sidebar (Initially hidden via opacity-0) -->
    <aside id="blog-sidebar" class="hidden xl:block w-[250px] shrink-0 sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pr-2 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out">
      <div class="flex flex-col gap-6">
        
        <!-- Back to Blog -->
        <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/fr/blog`} class="group flex items-center gap-2 text-cohere-slate hover:text-cohere-nearblack transition-colors font-body text-[14px] no-underline">
          <svg class="w-4 h-4 transform transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Blog
        </a>

        <!-- Sommaire dynamique -->
        {tocHeadings.length >= 2 && (
          <div class="space-y-3 pt-2 border-t border-cohere-hairline/70">
            <h3 class="font-mono text-[11px] text-cohere-muted tracking-widest uppercase">Sommaire</h3>
            <nav class="flex flex-col space-y-2.5 border-l border-cohere-hairline pl-4 font-mono text-[12px] leading-snug">
              {tocHeadings.map((heading, idx) => (
                <a
                  href={`#${heading.slug}`}
                  data-target={heading.slug}
                  class={`blog-toc-link transition-colors hover:text-cohere-nearblack no-underline ${
                    idx === 0
                      ? 'text-cohere-nearblack font-medium border-l-2 border-cohere-nearblack -ml-[17px] pl-[15px]'
                      : 'text-cohere-slate'
                  }`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        )}

        <!-- Écrit Par + Temps de lecture -->
        <div class="space-y-2.5 pt-2 border-t border-cohere-hairline/70">
          <h3 class="font-mono text-[11px] text-cohere-muted tracking-widest uppercase">Écrit Par</h3>
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-cohere-nearblack flex items-center justify-center shrink-0">
              <span class="font-display text-white text-xs">K</span>
            </div>
            <div class="flex flex-col">
              <span class="font-body text-cohere-nearblack font-medium text-[14px] leading-tight">K4yan0</span>
              <span class="font-mono text-[11px] text-cohere-muted uppercase tracking-wider mt-0.5">{readingTime} min de lecture</span>
            </div>
          </div>
        </div>

        <!-- Catégories (Compact) -->
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="space-y-2.5">
            <h3 class="font-mono text-[11px] text-cohere-muted tracking-widest uppercase">Catégories</h3>
            <div class="flex flex-wrap gap-1.5">
              {entry.data.tags.map((tag) => (
                <Tag variant="blog" label={tag} className="!text-[11px] !px-2.5 !py-1" />
              ))}
            </div>
          </div>
        )}

        <!-- Partager (X & LinkedIn) -->
        <div class="space-y-2.5">
          <h3 class="font-mono text-[11px] text-cohere-muted tracking-widest uppercase">Partager</h3>
          <div class="flex gap-4">
            <a href={`https://x.com/intent/tweet?url=${new URL(Astro.url.pathname, Astro.site).href}&text=${encodeURIComponent(entry.data.title || '')}`} target="_blank" rel="noopener noreferrer" aria-label="Partager sur X" class="text-cohere-slate hover:text-cohere-nearblack transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${new URL(Astro.url.pathname, Astro.site).href}&title=${encodeURIComponent(entry.data.title || '')}`} target="_blank" rel="noopener noreferrer" aria-label="Partager sur LinkedIn" class="text-cohere-slate hover:text-cohere-blue transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/></svg>
            </a>
          </div>
        </div>

        <!-- CTA Box -->
        <div class="p-5 bg-cohere-stone border border-cohere-hairline rounded-md">
          <h3 class="font-display text-[16px] text-cohere-nearblack tracking-tight leading-snug mb-3">
            Intéressé par ces travaux ou à la recherche d'un stagiaire IA &amp; Data pour mai 2027 ?
          </h3>
          <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/fr/contact`} class="inline-flex items-center gap-2 text-cohere-blue font-body text-[13px] hover:underline underline-offset-4 transition-all">
            Discutons-en
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </aside>

    <article class="flex-1 min-w-0 max-w-3xl">
    <header id="article-header" class="mb-16 space-y-8">
      {entry.data.coverImage && (
        <div class="w-full">
          <div class="w-full aspect-[21/9] rounded-[22px] overflow-hidden border border-cohere-hairline bg-cohere-stone">
            <img src={entry.data.coverImage} alt={entry.data.title} class="w-full h-full object-cover" />
          </div>
          {entry.data.coverCredit && (
            <p class="mt-3 text-center text-[13px] text-cohere-slate font-body italic">
              {entry.data.coverCredit}
            </p>
          )}
        </div>
      )}
      
      <div class="space-y-6">
        <div class="flex flex-wrap gap-4 items-center border-b border-cohere-hairline pb-6">
          <time class="font-mono text-[12px] text-cohere-muted tracking-wider uppercase">
            {entry.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <div class="w-1 h-1 bg-cohere-hairline rounded-full"></div>
          <span class="font-mono text-[12px] text-cohere-muted tracking-wider uppercase">
            {readingTime} min de lecture
          </span>
          <div class="w-1 h-1 bg-cohere-hairline rounded-full"></div>
          <div class="flex gap-2">
            {entry.data.tags.map((tag) => (
              <Tag variant="blog" label={tag} />
            ))}
          </div>
        </div>
        
        <div class="pt-4 space-y-4">
          <h1 class="font-display text-[48px] md:text-[60px] leading-[1.1] tracking-[-1.2px] text-cohere-nearblack">
            {entry.data.title}
          </h1>
          <p class="font-body text-[20px] leading-[1.5] text-cohere-slate max-w-2xl">
            {entry.data.description}
          </p>
        </div>
      </div>
    </header>

    <div class="prose prose-lg max-w-none 
      prose-headings:font-display prose-headings:text-cohere-nearblack prose-headings:tracking-tight prose-headings:scroll-mt-28
      prose-h1:text-[48px] prose-h1:tracking-[-0.48px] prose-h1:leading-[1.2]
      prose-h2:text-[32px] prose-h2:tracking-[-0.32px] prose-h2:leading-[1.2]
      prose-h3:text-[24px] prose-h3:leading-[1.3]
      prose-p:font-body prose-p:text-cohere-ink prose-p:text-[18px] prose-p:leading-[1.6]
      prose-a:text-cohere-blue prose-a:underline prose-a:underline-offset-4 prose-a:decoration-cohere-hairline hover:prose-a:decoration-cohere-blue transition-colors
      prose-code:font-mono prose-code:text-[14px] prose-code:bg-cohere-stone prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-code:border prose-code:border-cohere-hairline before:content-none after:content-none
      prose-pre:border prose-pre:border-cohere-hairline prose-pre:rounded-lg prose-pre:bg-cohere-nearblack
      prose-strong:text-cohere-nearblack prose-strong:font-medium
      prose-hr:border-cohere-hairline
      prose-blockquote:border-l-cohere-hairline prose-blockquote:border-l-[1px] prose-blockquote:text-cohere-slate prose-blockquote:font-normal prose-blockquote:not-italic
      prose-ul:font-body prose-ul:text-cohere-ink prose-ol:font-body prose-ol:text-cohere-ink
      prose-li:my-1
    ">
      <Content />
    </div>
  </article>
  </div>

  <script>
    // Intersection Observer to show sidebar only when header is out of view
    // Use astro:page-load instead of DOMContentLoaded to support Astro View Transitions
    document.addEventListener('astro:page-load', () => {
      const header = document.getElementById('article-header');
      const sidebar = document.getElementById('blog-sidebar');
      
      if (header && sidebar) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) {
              sidebar.classList.remove('opacity-0', 'pointer-events-none');
              sidebar.classList.add('opacity-100');
            } else {
              sidebar.classList.add('opacity-0', 'pointer-events-none');
              sidebar.classList.remove('opacity-100');
            }
          },
          { threshold: 0 } // Triggers exactly when the header leaves/enters the viewport
        );
        observer.observe(header);
      }

      const tocLinks = document.querySelectorAll('.blog-toc-link');
      if (tocLinks.length) {
        const targets = Array.from(tocLinks)
          .map((link) => document.getElementById(link.getAttribute('data-target') || ''))
          .filter((el): el is HTMLElement => Boolean(el));

        if (targets.length) {
          const tocObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting && entry.target.id) {
                  tocLinks.forEach((link) => {
                    if (link.getAttribute('data-target') === entry.target.id) {
                      link.classList.remove('text-cohere-slate');
                      link.classList.add('text-cohere-nearblack', 'font-medium', 'border-l-2', 'border-cohere-nearblack', '-ml-[17px]', 'pl-[15px]');
                    } else {
                      link.classList.remove('text-cohere-nearblack', 'font-medium', 'border-l-2', 'border-cohere-nearblack', '-ml-[17px]', 'pl-[15px]');
                      link.classList.add('text-cohere-slate');
                    }
                  });
                }
              });
            },
            { rootMargin: '-15% 0px -70% 0px' }
          );

          targets.forEach((el) => tocObserver.observe(el));
        }
      }
    });
  </script>
</BaseLayout>
